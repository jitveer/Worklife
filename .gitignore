# -----------------------------------------------------------------------------
# WORKLIFE GIT IGNORE CONFIGURATION
# Protects secrets, cache, and massive binary directories from repository push.
# -----------------------------------------------------------------------------

# Secret Environment Files (CRITICAL SECURITY)
.env
.env.local
.env.production
.env.development

# Local User Uploads (Prevents bloated commits & data leaks of medical certificates/photos)
uploads/
public/uploads/

# Node Package Dependencies
node_modules/
jspm_packages/

# Production Build Caches & Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PM2 runtime processes
.pm2/
pids/

# OS Metadata & IDE settings
.DS_Store
Thumbs.db
.idea/
.vscode/
.gemini/
